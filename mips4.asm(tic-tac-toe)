#Instructions developed with help from ChatGPT OpenAI

.data
board: .word 0,0,0,0,0,0,0,0,0

# Winning combinations
wins: .word 0,1,2, 3,4,5, 6,7,8
      .word 0,3,6, 1,4,7, 2,5,8
      .word 0,4,8, 2,4,6

msg:  .asciiz "\nEnter position (1-9): "
bad:  .asciiz "Invalid move! Try again.\n"
win:  .asciiz "\nPlayer wins!\n"
draw: .asciiz "\nDraw!\n"

.text
.globl main

main:
    li $s0, 1       # Player 1 = X
    li $s1, 0       # Move count

    jal drawBoard

loop:
    li $v0, 4
    la $a0, msg
    syscall

    li $v0, 5
    syscall

    # Check input is between 1 and 9
    blt $v0, 1, invalid
    bgt $v0, 9, invalid

    # Convert input to board index (0-8)
    addi $t0, $v0, -1
    sll $t0, $t0, 2

    la $t1, board
    add $t1, $t1, $t0

    # Check whether the selected cell is empty
    lw $t2, 0($t1)
    bne $t2, $zero, invalid

    # Store current player's mark
    sw $s0, 0($t1)

    # Draw the player's mark
    move $a0, $v0
    addi $a0, $a0, -1
    move $a1, $s0
    jal drawMark

    # Count the move
    addi $s1, $s1, 1

    # Check if current player won
    jal checkWin
    bne $v0, $zero, winner

    # Check for draw
    li $t0, 9
    beq $s1, $t0, tie

    # Switch players
    li $t0, 1
    beq $s0, $t0, playerO

    li $s0, 1
    j loop

playerO:
    li $s0, 2
    j loop

invalid:
    li $v0, 4
    la $a0, bad
    syscall
    j loop

winner:
    li $v0, 4
    la $a0, win
    syscall
    j exit

tie:
    li $v0, 4
    la $a0, draw
    syscall

exit:
    li $v0, 10
    syscall

# pixel
# Draw one pixel at coordinates (a0, a1)
# Color is in a2

pixel:
    li $t0, 32
    mul $t1, $a1, $t0
    add $t1, $t1, $a0
    sll $t1, $t1, 2

    li $t0, 0x10008000
    add $t0, $t0, $t1

    sw $a2, 0($t0)
    jr $ra

# drawBoard
# Draws the Tic-Tac-Toe grid

drawBoard:
    addiu $sp, $sp, -12
    sw $ra, 8($sp)
    sw $s2, 4($sp)
    sw $s3, 0($sp)

    # Clear display
    li $t0, 0x10008000
    li $t1, 1024

clear:
    sw $zero, 0($t0)
    addi $t0, $t0, 4
    addi $t1, $t1, -1
    bgtz $t1, clear

    # Draw grid lines
    li $s2, 0

grid:
    li $s3, 0

gridLoop:
    move $a0, $s2
    move $a1, $s3
    li $a2, 0x00FFFFFF

    # Vertical lines at x=10 and x=20
    li $t0, 10
    beq $s2, $t0, drawLine

    li $t0, 20
    beq $s2, $t0, drawLine

    # Horizontal lines at y=10 and y=20
    li $t0, 10
    beq $s3, $t0, drawLine

    li $t0, 20
    beq $s3, $t0, drawLine

    j skip

drawLine:
    jal pixel

skip:
    addi $s3, $s3, 1
    li $t0, 32
    blt $s3, $t0, gridLoop

    addi $s2, $s2, 1
    li $t0, 32
    blt $s2, $t0, grid

    lw $s3, 0($sp)
    lw $s2, 4($sp)
    lw $ra, 8($sp)
    addiu $sp, $sp, 12
    jr $ra

# drawMark
# a0 = board position (0-8)
# a1 = player (1 or 2)
#
# Fixed: saves registers that must survive
# calls to pixel, preventing bad addresses.

drawMark:
    addiu $sp, $sp, -32

    sw $ra, 28($sp)
    sw $s0, 24($sp)
    sw $s1, 20($sp)
    sw $s2, 16($sp)
    sw $s3, 12($sp)
    sw $s4, 8($sp)
    sw $s5, 4($sp)

    # Save arguments
    move $s0, $a0       # Position
    move $s1, $a1       # Player

    # Find row and column
    li $t0, 3
    div $s0, $t0
    mflo $s2            # Row
    mfhi $s3            # Column

    # Pixel coordinates inside cell
    mul $s2, $s2, 10
    addi $s2, $s2, 2

    mul $s3, $s3, 10
    addi $s3, $s3, 2

    # X = red, O = blue
    li $s4, 0x00FF0000
    li $t0, 1
    beq $s1, $t0, startDraw

    li $s4, 0x000000FF

startDraw:
    li $s5, 0           # Y counter

fillY:
    sw $zero, 0($sp)    # X counter

fillX:
    # Get X counter
    lw $t5, 0($sp)

    # Set pixel coordinates and color
    add $a0, $s3, $t5
    add $a1, $s2, $s5
    move $a2, $s4

    # Draw pixel
    jal pixel

    # Increase X counter
    lw $t5, 0($sp)
    addi $t5, $t5, 1
    sw $t5, 0($sp)

    li $t6, 6
    blt $t5, $t6, fillX

    # Increase Y counter
    addi $s5, $s5, 1

    li $t6, 6
    blt $s5, $t6, fillY

    # Restore saved registers
    lw $s5, 4($sp)
    lw $s4, 8($sp)
    lw $s3, 12($sp)
    lw $s2, 16($sp)
    lw $s1, 20($sp)
    lw $s0, 24($sp)
    lw $ra, 28($sp)

    addiu $sp, $sp, 32
    jr $ra

# checkWin
# Returns 1 or 2 if a player won.
# Returns 0 if nobody has won.

checkWin:
    la $t0, wins
    li $t1, 8

check:
    # Get the three board positions
    lw $t2, 0($t0)
    lw $t3, 4($t0)
    lw $t4, 8($t0)

    # Convert positions to byte offsets
    sll $t2, $t2, 2
    sll $t3, $t3, 2
    sll $t4, $t4, 2

    la $t5, board

    # Get first position's value
    add $t6, $t5, $t2
    lw $t7, 0($t6)

    # Empty cell cannot be a winning line
    beq $t7, $zero, next

    # Compare second position
    add $t6, $t5, $t3
    lw $t8, 0($t6)
    bne $t7, $t8, next

    # Compare third position
    add $t6, $t5, $t4
    lw $t8, 0($t6)
    beq $t7, $t8, won

next:
    addi $t0, $t0, 12
    addi $t1, $t1, -1
    bgtz $t1, check

    li $v0, 0
    jr $ra

won:
    move $v0, $t7
    jr $ra
